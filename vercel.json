{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{.ethco/system/SYSTEM.md,.ethco/system/PLANNING-AND-EXECUTION.md,.ethco/system/THINKING-EXPERT.md,.ethco/system/ETHCO-LITE-SYSTEM-PROMPT.md,.ethco/system/TOOL-SCHEMAS.md}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
