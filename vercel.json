{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{SYSTEM.md,TOOL-SCHEMAS.md}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
